@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<div class="flex flex-col gap-1 md:ml-3 md:flex-row md:items-center md:gap-1 md:border-l md:border-asphalt/10 md:pl-3">
@if (SignInManager.IsSignedIn(User))
{
    <a class="nav-link-park" asp-area="Identity" asp-page="/Account/Manage/Index" title="Gestione account">
        Ciao @User.Identity?.Name!
    </a>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="nav-link-park w-full text-left md:w-auto">Esci</button>
    </form>
}
else
{
    <a class="nav-link-park" asp-area="Identity" asp-page="/Account/Register">Registrati</a>
    <a class="nav-link-park font-semibold text-primary" asp-area="Identity" asp-page="/Account/Login">Accedi</a>
}
</div>
