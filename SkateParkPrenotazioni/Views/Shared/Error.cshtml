@model ErrorViewModel
@{
    ViewData["Title"] = "Errore";
}

<section class="page-shell max-w-3xl">
    <h1 class="text-4xl text-red-700">Si è verificato un errore</h1>
    <p class="mt-3 text-asphalt-muted dark:text-park-concrete/80">
        Non è stato possibile completare la richiesta. Riprova più tardi.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-sm">
            <strong>Request ID:</strong> <code class="rounded bg-park-concrete px-1.5 py-0.5">@Model.RequestId</code>
        </p>
    }
</section>
