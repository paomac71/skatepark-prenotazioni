@model IEnumerable<SkateParkPrenotazioni.Models.Booking>
@{
    ViewData["Title"] = "Le mie prenotazioni";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Le mie prenotazioni</h1>
    <a class="btn btn-primary" asp-action="Create">Nuova prenotazione</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Non hai ancora prenotazioni. Creane una per iniziare.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Istruttore</th>
                    <th>Tipo</th>
                    <th>Durata</th>
                    <th>Partecipanti</th>
                    <th>Stato</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr class="@(b.IsCancelled ? "table-secondary" : "")">
                    <td>@b.StartAt.ToString("g")</td>
                    <td>@b.Instructor?.Name</td>
                    <td>@b.LessonType</td>
                    <td>@b.LessonDuration?.Label</td>
                    <td>@b.Participants</td>
                    <td>@(b.IsCancelled ? "Annullata" : "Attiva")</td>
                    <td class="text-end">
                        @if (!b.IsCancelled)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id">Modifica</a>
                            <form asp-action="Cancel" asp-route-id="@b.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Annullare questa prenotazione?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Annulla</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
