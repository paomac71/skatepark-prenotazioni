@model IReadOnlyList<SkateParkPrenotazioni.ViewModels.BookingListItemViewModel>
@{
    ViewData["Title"] = "Le mie prenotazioni";
}

<section class="page-shell">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-4xl text-asphalt dark:text-park-concrete">Le mie prenotazioni</h1>
            <p class="mt-2 text-asphalt-muted dark:text-park-concrete/70">Gestisci lezioni private e di gruppo.</p>
        </div>
        <a class="btn-primary" asp-action="Create">Nuova prenotazione</a>
    </div>

    @if (!Model.Any())
    {
        <div class="card-surface">
            <p class="text-asphalt-muted dark:text-park-concrete/70">Non hai ancora prenotazioni. Creane una per iniziare.</p>
            <a class="btn-accent mt-4 inline-flex" asp-action="Create">Prenota ora</a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-white/70 bg-white/80 shadow-sm dark:border-asphalt-muted/40 dark:bg-asphalt/70">
            <table class="min-w-full text-left text-sm">
                <thead class="border-b border-asphalt/10 bg-park-mist/80 font-display text-xs uppercase tracking-wider text-asphalt-muted dark:border-asphalt-muted/40 dark:bg-asphalt-muted/20 dark:text-park-concrete/70">
                    <tr>
                        <th class="px-4 py-3">Data</th>
                        <th class="px-4 py-3">Istruttore</th>
                        <th class="px-4 py-3">Tipo</th>
                        <th class="px-4 py-3">Durata</th>
                        <th class="px-4 py-3">Partecipanti</th>
                        <th class="px-4 py-3">Stato</th>
                        <th class="px-4 py-3"><span class="sr-only">Azioni</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model)
                {
                    <tr class="border-b border-asphalt/5 last:border-0 @(b.IsCancelled ? "opacity-60" : "") dark:border-asphalt-muted/20">
                        <td class="px-4 py-3 whitespace-nowrap">@b.StartAt.ToString("g")</td>
                        <td class="px-4 py-3">@b.InstructorName</td>
                        <td class="px-4 py-3">@b.LessonType</td>
                        <td class="px-4 py-3">@b.DurationLabel</td>
                        <td class="px-4 py-3">@b.Participants</td>
                        <td class="px-4 py-3">@(b.IsCancelled ? "Annullata" : "Attiva")</td>
                        <td class="px-4 py-3 text-right">
                            @if (!b.IsCancelled)
                            {
                                <div class="flex flex-wrap justify-end gap-2">
                                    <a class="btn-outline btn-sm" asp-action="Edit" asp-route-id="@b.Id">Modifica</a>
                                    <form asp-action="Cancel" asp-route-id="@b.Id" method="post"
                                          onsubmit="return confirm('Annullare questa prenotazione?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-danger btn-sm">Annulla</button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
