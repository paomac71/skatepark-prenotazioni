@model SkateParkPrenotazioni.ViewModels.BookingCalendarViewModel
@{
    ViewData["Title"] = "Nuova prenotazione";
}

<section class="page-shell max-w-4xl">
    <header class="mb-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">Passo 2 di 2</p>
        <h1 class="mt-2 text-4xl text-asphalt dark:text-park-concrete">Calendario — @Model.InstructorName</h1>
        <p class="mt-2 text-asphalt-muted dark:text-park-concrete/70">
            Scegli durata e tipologia, poi un giorno disponibile e un orario libero.
        </p>
    </header>

    <div class="card-surface">
        <partial name="_BookingCalendarForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking-calendar.js" asp-append-version="true"></script>
}
