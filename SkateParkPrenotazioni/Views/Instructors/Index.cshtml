@model IEnumerable<SkateParkPrenotazioni.Models.Instructor>
@{
    ViewData["Title"] = "Istruttori";
}

<h1>Istruttori</h1>
<p class="text-muted">Capienze massime per slot e specialità.</p>

<div class="row g-3">
@foreach (var instructor in Model)
{
    <div class="col-md-4">
        <div class="border rounded p-3 h-100">
            <h2 class="h5 mb-1">@instructor.Name</h2>
            <p class="mb-2">@instructor.Bio</p>
            <p class="mb-0"><strong>Capienza max:</strong> @instructor.MaxParticipants</p>
        </div>
    </div>
}
</div>
