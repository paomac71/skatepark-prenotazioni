@model IReadOnlyList<SkateParkPrenotazioni.ViewModels.InstructorListItemViewModel>
@{
    ViewData["Title"] = "Istruttori";
}

<section class="page-shell">
    <header class="mb-8 max-w-2xl">
        <h1 class="text-4xl text-asphalt dark:text-park-concrete">Istruttori</h1>
        <p class="mt-2 text-asphalt-muted dark:text-park-concrete/70">
            Capienze massime per slot e specialità. Scegli chi ti segue in prenotazione.
        </p>
    </header>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    @foreach (var instructor in Model)
    {
        <article class="card-surface">
            <h2 class="text-2xl text-primary">@instructor.Name</h2>
            <p class="mt-2 text-sm leading-relaxed text-asphalt-muted dark:text-park-concrete/75">@instructor.Bio</p>
            <p class="mt-4 text-sm font-semibold text-asphalt dark:text-park-concrete">
                Capienza max: <span class="text-primary">@instructor.MaxParticipants</span>
            </p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn-primary mt-5 inline-flex"
                   asp-controller="Bookings"
                   asp-action="Create"
                   asp-route-instructorId="@instructor.Id">
                    Prenota con @instructor.Name
                </a>
            }
        </article>
    }
    </div>
</section>
